Vagrant.configure("2") do |config|
  #K3s_URL = ENV['K3S_URL']
  #K3S_TOKEN = ENV['K3S_TOKEN']
  K3S_URL = "https://192.168.0.50:6443"
  K3S_TOKEN = "MySuperSecretToken"

  config.vm.define "control" do |control|
    config.vm.box = "generic/ubuntu2204"
    config.vm.box_version = "4.3.12"
    control.vm.hostname = "control"
    control.vm.network "public_network", :dev => "br0", :mode => "bridge", :type => "bridge", :ip => "192.168.0.50"
    control.vm.provider "libvirt" do |lv|
      lv.memory = 2048
      lv.cpus = 2
    end
    control.vm.provision "shell", run: "always", env: {"K3S_TOKEN" => K3S_TOKEN}, inline: <<-SHELL
      set -e
      cat > /etc/netplan/99-override.yaml <<EOF
---
network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: true
      dhcp6: false
      optional: true
      nameservers:
        addresses: [4.2.2.1, 4.2.2.2, 208.67.220.220]
    eth1:
      addresses:
      - 192.168.0.50/24
      routes:
        - to: default
          via: 192.168.0.1
EOF
      netplan apply
      #ip route replace default via 192.168.0.1 dev eth1 metric 50
      curl -sfL https://get.k3s.io | K3S_TOKEN=$K3S_TOKEN sh -s - server --node-ip=192.168.0.50 --flannel-iface=eth1
    SHELL
  end

  config.vm.define "agent" do |agent|
    config.vm.box = "generic/ubuntu2204"
    config.vm.box_version = "4.3.12"
    agent.vm.hostname = "agent"
    agent.vm.network "public_network", :dev => "br0", :mode => "bridge", :type => "bridge", :ip => "192.168.0.51"
    agent.vm.provider "libvirt" do |lv|
      lv.memory = 1024
      lv.cpus = 1
    end
    agent.vm.provision "shell", env: {"K3S_URL" => K3S_URL, "K3S_TOKEN" => K3S_TOKEN}, inline: <<-SHELL
      set -e
      cat > /etc/netplan/99-override.yaml <<EOF
---
network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: true
      dhcp6: false
      optional: true
      nameservers:
        addresses: [4.2.2.1, 4.2.2.2, 208.67.220.220]
    eth1:
      addresses:
      - 192.168.0.51/24
      routes:
        - to: default
          via: 192.168.0.1
EOF
      netplan apply
      #ip route replace default via 192.168.0.1 dev eth1 metric 50
      curl -sfL https://get.k3s.io | K3S_URL=$K3S_URL K3S_TOKEN=$K3S_TOKEN sh -s - agent --node-ip=192.168.0.51 --flannel-iface=eth1
    SHELL
  end
  
end